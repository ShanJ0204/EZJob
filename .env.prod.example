# Container images
API_IMAGE=ghcr.io/your-org/ezjob-api:latest
WORKER_IMAGE=ghcr.io/your-org/ezjob-worker:latest

# Runtime
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=8000

# Datastores
POSTGRES_USER=ezjob
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ezjob
DATABASE_URL=postgresql://ezjob:change-me@postgres:5432/ezjob?schema=public
REDIS_URL=redis://redis:6379

# Worker
WORKER_CONCURRENCY=5
INGESTION_POLL_INTERVAL_MS=60000
ORCHESTRATION_LOCK_KEY=ezjob:worker:orchestration:lock
INGESTION_MODE=live
INGESTION_FIXTURE_FILE=apps/worker/src/ingestion/connectors/fixtures/demo-jobs.json
SCRAPLING_PYTHON_BIN=python3
SCRAPLING_SCRIPT_PATH=apps/worker/src/ingestion/connectors/scripts/scrapling_weworkremotely.py
SCRAPLING_TARGET_URL=https://weworkremotely.com/remote-jobs

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEFAULT=
TELEGRAM_CHAT_ID_MAP=
