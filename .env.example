# Shared
NODE_ENV=development
DATABASE_URL=postgresql://ezjob:ezjob@127.0.0.1:5432/ezjob?schema=public
REDIS_URL=redis://127.0.0.1:6379

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker
WORKER_CONCURRENCY=5
INGESTION_POLL_INTERVAL_MS=60000
ORCHESTRATION_LOCK_KEY=ezjob:worker:orchestration:lock
# Set to "fixture" for deterministic demo data, "live" for Remotive + WeWorkRemotely, or "scrapling" for Scrapling-driven scraping
INGESTION_MODE=fixture
# Optional path override when INGESTION_MODE=fixture
INGESTION_FIXTURE_FILE=apps/worker/src/ingestion/connectors/fixtures/demo-jobs.json
# Optional settings when INGESTION_MODE=scrapling
SCRAPLING_PYTHON_BIN=python3
SCRAPLING_SCRIPT_PATH=apps/worker/src/ingestion/connectors/scripts/scrapling_weworkremotely.py
SCRAPLING_TARGET_URL=https://weworkremotely.com/remote-jobs

# Telegram notifications (required for real Telegram delivery)
TELEGRAM_BOT_TOKEN=
# Set one of these:
TELEGRAM_CHAT_ID_DEFAULT=
# TELEGRAM_CHAT_ID_MAP={"<user-uuid>":"<chat-id>"}
TELEGRAM_CHAT_ID_MAP=
